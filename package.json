{
  "name": "conversaciones-mvp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "client": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "server": "nodemon server/index.js",
    "db:setup": "psql \"$DATABASE_URL\" -f server/schema.sql",
    "db:seed": "psql \"$DATABASE_URL\" -f server/seed.sql"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "nodemon": "^3.1.9",
    "pg": "^8.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.1.1",
    "vite": "^6.0.7"
  }
}
